e:37px;font-weight:900;color:var(--teal);margin:2px 0;font-variant-numeric:tabular-nums}.divider{border:0;border-top:1px solid var(--border);margin:19px 0}.rank-big{font-size:34px;font-weight:950;line-height:1.25;overflow-wrap:anywhere}.rank-caption{font-size:12px;color:var(--muted);margin-top:6px}.rank-progress{margin:14px 0 10px}.side-line{display:flex;justify-content:space-between;gap:10px;font-size:13px;padding:8px 0;color:var(--muted)}.side-line b{color:var(--text)}.details{margin-top:18px;padding:0 21px}.details>summary{cursor:pointer;padding:20px 0;font-weight:800;list-style:none}.details>summary::-webkit-details-marker{display:none}.details>summary::before{content:"＋";color:var(--teal);margin-right:12px}.details[open]>summary::before{content:"－"}.inside{padding-bottom:22px}.control-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.field label{display:block;font-size:13px;font-weight:750;margin-bottom:7px}.field select,.field textarea{width:100%;border:1px solid #40516b;border-radius:9px;padding:10px;color:var(--text);background:#0b1525}.field textarea{resize:vertical;min-height:65px}.check{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--muted);margin:8px 0}.check input{accent-color:#64e4cf;width:16px;height:16px}.note{border-left:3px solid var(--teal);padding:8px 13px;color:var(--muted);font-size:12px;line-height:1.8;margin-top:15px;background:#101d30}.results{margin-top:18px;display:none}.results.active{display:block}.result-head{display:flex;gap:20px;justify-content:space-between;align-items:start;flex-wrap:wrap}.hero-score{font-size:clamp(42px,8vw,70px);font-weight:950;letter-spacing:-.055em;font-variant-numeric:tabular-nums;color:var(--teal)}.result-rank{font-size:24px;font-weight:900;margin:7px 0}.pills{display:flex;flex-wrap:wrap;gap:7px;margin-top:14px}.pill{background:#1a3047;border:1px solid #35516a;border-radius:100px;padding:6px 12px;font-size:12px;color:#d6ecfb}.result-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:18px 0}.data-card{background:#0d192b;border:1px solid #283b53;border-radius:12px;padding:14px}.data-card strong{display:block;font-size:23px;font-variant-numeric:tabular-nums;margin-top:7px}.chart-card{background:#0b1729;border:1px solid #283b53;border-radius:13px;padding:18px;margin:15px 0}.chart-card h3{margin:0 0 9px;font-size:15px}.chart-card canvas{display:block;width:100%;height:205px}.analysis-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.analysis-card{background:#0c1728;border:1px solid #2d415b;border-radius:12px;padding:15px}.analysis-card h3{font-size:15px;margin:0 0 12px}.analysis-card p,.analysis-card li{color:#b7c7da;font-size:13px;line-height:1.8}.analysis-card ul{padding-left:20px;margin:0}.key-row{display:flex;gap:5px;justify-content:center;margin:5px 0}.key{min-width:0;flex:1;max-width:44px;height:38px;display:flex;align-items:center;justify-content:center;border-radius:6px;border:1px solid #314359;background:#26374c;color:#b4c4d9;font:700 12px ui-monospace,monospace;position:relative}.key.good{background:#1d5b53;border-color:#3e9e88;color:#bdffea}.key.mid{background:#614e2d;border-color:#a48646;color:#ffe5b3}.key.bad{background:#663143;border-color:#a85470;color:#ffcad3}.key small{position:absolute;bottom:1px;right:2px;font-size:8px;opacity:.7}.muted{color:var(--muted)}.history-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.history-list{max-height:250px;overflow:auto}.record{border-bottom:1px solid #293a52;padding:10px 2px;display:flex;justify-content:space-between;gap:9px;font-size:12px;color:var(--muted)}.record strong{color:var(--text)}.footer{font-size:12px;text-align:center;color:#778ba6;margin-top:29px}.status-banner{font-size:12px;border:1px solid #314961;padding:8px 11px;border-radius:9px;background:#10223a;margin-top:10px}.hidden-panel{display:none!important}@media(max-width:850px){.layout{grid-template-columns:1fr}.side{display:grid;grid-template-columns:1fr 1fr;gap:10px}.side .divider{display:none}.side .wide{grid-column:span 2}.analysis-grid,.history-grid{grid-template-columns:1fr}}@media(max-width:560px){.shell{padding:18px 12px 50px}.play{padding:16px}.topbar{margin-bottom:17px}.tag{display:none}.statstrip{grid-template-columns:repeat(2,1fr)}.prompt{padding:21px 13px}.timebar{margin:20px 0 16px}.side{padding:17px}.result-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.control-grid{grid-template-columns:1fr}.details{padding:0 15px}.key{height:33px;font-size:11px}.japanese{max-height:140px}.chart-card{padding:10px}}
