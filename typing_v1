  function onKey(e) {
    if (!session||!['ready','running'].includes(session.phase))return;
    if (e.key==='Escape') {if(session.phase==='running'){e.preventDefault();abort('測定を中止しました。記録は保存していません。');}return;}
    const target=e.target;
    if (target instanceof Element && target.closest('input,textarea,select,button,[contenteditable="true"],summary'))return;
    if (e.ctrlKey||e.metaKey||e.altKey||e.isComposing||e.key==='Process'||e.keyCode===229) {
      if(e.isComposing||e.key==='Process'||e.keyCode===229){message='日本語入力（IME）をオフにして入力してください。';renderLive();}
      return;
    }
    if (e.repeat)return;
    const key=e.key.length===1?e.key.toLowerCase():'';
    if (!/^[a-z0-9'\-]$/.test(key))return;
    // 測定中はキー入力がブラウザ操作に伝播しないようにする。
    e.preventDefault();
    const now=performance.now();
    if (session.phase==='running' && session.mode!=='long' && now-session.started>=Number(session.mode)*1000) {
      finish(Number(session.mode));return;
    }
    if (session.phase==='ready') {
      session.phase='running';session.started=now;message='計測中です。正確に入力してください。';
      rafId=requestAnimationFrame(tick);
    }
    const next=advance(session.states,session.tokens,key);
    if (!next.length) {
      session.wrong++;addEvent(key,now,false);message='ミスを記録しました。同じ位置から続けてください。';
      $('promptBox').classList.remove('flash');void $('promptBox').offsetWidth;$('promptBox').classList.add('flash');
    } else {
      session.correct++;addEvent(key,now,true);session.states=next;session.typed+=key;
      if (next.some(s=>s.i===session.tokens.length)) {
        session.phrasesDone++;
        if (session.mode!=='long') session.completedKana+=session.tokens.reduce((a,t)=>a+t.kana.length,0);
        if (session.mode==='long') {finish(Math.max(.001,(now-session.started)/1000));return;}
        const phrase=choosePhrase();
        session.phrase=phrase;session.tokens=tokensOf(phrase.reading);
        session.states=startStates(session.tokens);session.typed='';
      }
      message='計測中です。正確に入力してください。';
    }
    renderPrompt();renderLive();
  }
  function abort(text) {
    cancelAnimationFrame(rafId);message=text;
    $('status').classList.add('error');
    newSession();message=text;
    $('status').textContent=message;$('status').classList.add('error');
  }

  // ----- 集計 / 保存 -----------------------------------------------------
  function bucketsFor(events,elapsed) {
    const bins=[];
    const total=Math.ceil(elapsed/5);
    for(let i=0;i<total;i++) {
      const segment=Math.min(5,elapsed-5*i);
      if(segment<2.5)break; // 長文の端数区間が不当に大きく見えるのを避ける
      const count=events.filter(e=>e.correct && e.ms>=i*5000 && e.ms<(i+1)*5000).length;
      bins.push({x:Math.min((i+1)*5,elapsed),y:count*60/segment});
    }
    return bins;
  }
  function stdev(nums) {
    if(!nums.length)return null;
    const m=nums.reduce((a,b)=>a+b,0)/nums.length;
    return Math.sqrt(nums.reduce((a,b)=>a+(b-m)**2,0)/nums.length);
  }
  function extrasFor(events,elapsed) {
    const bins=bucketsFor(events,elapsed);
    const speeds=bins.map(x=>x.y);
    const mean=speeds.length?speeds.reduce((a,b)=>a+b,0)/speeds.length:0;
    const cv=speeds.length>=4 && mean>0 ? stdev(speeds)/mean:null;
    const stability=cv===null?null:clamp(100/(1+2*cv),0,100);
    const thirds=elapsed/3;
    const count=(a,b)=>events.filter(e=>e.correct&&e.ms>=a*1000&&e.ms<b*1000).length;
    const first=count(0,thirds),last=count(thirds*2,elapsed+0.0001);
    const endurance=elapsed>=30&&first>0 ? last/first*100:null;
    const times=events.filter(e=>e.correct).map(e=>e.ms).sort((a,b)=>a-b);
    let peak=0,left=0;
    for(let right=0;right<times.length;right++) {
      while(times[right]-times[left]>5000)left++;
      peak=Math.max(peak,right-left+1);
    }
    return {bins,stability,endurance,peakKpm:elapsed>=5?peak*12:null};
  }
  function finish(elapsed) {
    if(!session||session.phase!=='running')return;
    cancelAnimationFrame(rafId);
    const s=session;
    s.phase='finished';s.elapsed=elapsed;
    const scores=currentStats(elapsed);
    const active=preferred(s.states);
    const processed=s.completedKana+s.tokens.slice(0,active?.i||0).reduce((a,t)=>a+t.kana.length,0);
    const kanaCpm=processed/Math.max(.001,elapsed/60);
    const extra=extrasFor(s.events,elapsed);
    const record={version:1,date:new Date().toISOString(),mode:s.mode,elapsed,
      score:scores.score,raw:scores.raw,net:scores.net,kanaCpm,accuracy:scores.accuracy,
      correct:s.correct,wrong:s.wrong,phrases:s.phrasesDone,
      stability:extra.stability,endurance:extra.endurance,peakKpm:extra.peakKpm,
      bins:extra.bins,keyStats:s.keyStats,pairs:s.pairs,
      previousBest:s.previousBest,previous:s.previous};
    history.push(record);history=history.slice(-MAX_RECORDS);
    const saved=putJson(STORE,history);
    latestResult=record;
    message=saved?'測定完了。記録を保存しました。':'測定完了。ただしブラウザの保存領域に書き込めませんでした。';
    $('status').classList.remove('error');
    renderPrompt();renderLive();renderResults(record);renderSide();renderHistory();
    $('results').classList.add('active');
    requestAnimationFrame(()=>{drawSpeed(record);$('results').scrollIntoView({behavior:'smooth',block:'start'});});
  }

  // ----- 診断 / グラフ ---------------------------------------------------
  function metric(label,value,hint='') {
    return `<div class="data-card"><div class="eyebrow">${safeText(label)}</div><strong>${safeText(value)}</strong><span class="small">${safeText(hint)}</span></div>`;
  }
  function sortedKeys(r) {
    const entries=Object.entries(r.keyStats||{});
    const intervals=entries.filter(([,x])=>x.samples>=4).map(([,x])=>x.sumMs/x.samples);
    const baseline=intervals.length?intervals.sort((a,b)=>a-b)[Math.floor(intervals.length/2)]:null;
    return {baseline,keys:entries.map(([key,x])=>({key,...x,n:x.good+x.bad,
      missRate:x.good+x.bad?x.bad/(x.good+x.bad):0,
      avg:x.samples?x.sumMs/x.samples:null,
      weight:(x.good+x.bad?x.bad/(x.good+x.bad):0)*120+(baseline&&x.samples>=4?Math.max(0,(x.sumMs/x.samples)/baseline-1)*20:0)
    })).filter(x=>x.n>=5).sort((a,b)=>b.weight-a.weight)};
  }
  function renderKeyboard(r) {
    const {baseline,keys}=sortedKeys(r),lookup=Object.fromEntries(keys.map(k=>[k.key,k]));
    let html='';
    for(const row of ['qwertyuiop','asdfghjkl','zxcvbnm']){
      html+='<div class="key-row">';
      for(const key of row){
        const s=lookup[key];
        let cls='';
        if(s){
          const ratio=baseline&&s.avg?s.avg/baseline:1;
          cls=(s.missRate>=.08||ratio>=1.65)?'bad':(s.missRate>=.03||ratio>=1.3)?'mid':'good';
        }
        const title=s?`${key.toUpperCase()}：正解${s.good}回 / 推定ミス${s.bad}回 / ミス率${round(s.missRate*100)}% / 入力間隔${s.avg?round(s.avg,0)+'ms':'測定不足'}`:`${key.toUpperCase()}：データ不足（5回未満）`;
        html+=`<span class="key ${cls}" title="${safeText(title)}">${key.toUpperCase()}${s?`<small>${round(s.missRate*100,0)}%</small>`:''}</span>`;
      }
      html+='</div>';
    }
    $('keyboard').innerHTML=html;
  }
  function diagnosis(r) {
    const messages=[];
    if (r.correct+r.wrong<30) messages.push('入力数が少ないため、弱点の判定はまだ参考程度です。');
    if (r.accuracy>=.99) messages.push(`正確率${round(r.accuracy*100,2)}%。非常に丁寧な入力でした。`);
    else if(r.accuracy<.94) messages.push(`正確率${round(r.accuracy*100,2)}%。速度よりもミスの減少を優先すると総合スコアが伸びやすい状態です。`);
    else messages.push(`正確率${round(r.accuracy*100,2)}%。精度と速度を両立できています。`);
    if(r.stability!==null){
      if(r.stability>=80)messages.push('5秒ごとの速度変動が比較的小さく、安定したペースで入力できています。');
      else if(r.stability<60)messages.push('5秒ごとの速度変動が大きめです。入力が止まる部分の確認がおすすめです。');
    }
    if(r.endurance!==null){
      if(r.endurance<80)messages.push(`終盤の入力速度は序盤の約${round(r.endurance,0)}%。文章難度の差も含め、終盤にペースが落ちた可能性があります。`);
      else if(r.endurance>115)messages.push('終盤の入力が序盤より速くなっています。後半でペースを上げられています。');
    }
    const {keys}=sortedKeys(r);
    const weak=keys.find(x=>x.weight>=5);
    if(weak) messages.push(`${weak.key.toUpperCase()}キー周辺に改善余地があります（推定ミス率${round(weak.missRate*100,1)}%、標本${weak.n}回）。`);
    if(!messages.length)messages.push('まずは同じ条件で何度か測定し、速度と正確率の変化を確認しましょう。');
    $('diagnosis').innerHTML='<ul>'+messages.slice(0,5).map(m=>`<li>${safeText(m)}</li>`).join('')+'</ul>';
  }
  function renderPairs(r) {
    const pairs=Object.entries(r.pairs||{}).map(([k,v])=>({k,avg:v.count?v.sum/v.count:0,count:v.count})).filter(x=>x.count>=3).sort((a,b)=>b.avg-a.avg).slice(0,6);
    $('slowPairs').innerHTML=pairs.length?'<ul>'+pairs.map(x=>`<li><b style="color:#e8f5ff">${safeText(x.k)}</b>：平均 <b>${round(x.avg,0)}ms</b>（${x.count}回）</li>`).join('')+'</ul><p class="small">入力間隔には文章の読み取り時間も含まれます。指の運動速度そのものではありません。</p>':
      '<p>同じ2キーの組み合わせが3回以上現れていないため、今回は十分な分析ができません。</p>';
  }
  function comparison(r){
    let output='';
    if(r.previous!==null) {
      const diff=r.score-r.previous;
      output+=`<p>前回：<b>${round(r.previous)}</b> → 今回：<b>${round(r.score)}</b><br>差：<b style="color:${diff>=0?'#64e4cf':'#ff9eab'}">${diff>=0?'+':''}${round(diff)}</b></p>`;
    } else output+='<p>このモードの初回記録です。</p>';
    if(r.previousBest!==null) {
      const diff=r.score-r.previousBest;
      output+=`<p>測定前の自己ベスト：<b>${round(r.previousBest)}</b><br>${diff>0?'🎉 自己ベスト更新！':`自己ベストとの差：${round(diff)}`}</p>`;
    }
    output+='<p class="small">異なるモードの記録は混ぜずに比較しています。長文の出題文章による難度差は残ります。</p>';
    $('comparison').innerHTML=output;
  }
  function renderResults(r) {
    const g=grade(r.score);
    $('resultScore').textContent=round(r.score);
    $('resultRank').textContent=`RANK ${g.label}`;
    $('nextRank').textContent=g.next;
    $('nextNeeded').textContent=`あと ${round(g.threshold-r.score)} 点 / 次の境界 ${g.threshold} 点`;
    $('rankProgress').style.width=`${g.progress}%`;
    $('resultBadges').innerHTML=`<span class="pill">${r.mode==='long'?'長文':r.mode+'秒'}モード</span>`+
      (r.previousBest!==null&&r.score>r.previousBest?'<span class="pill">NEW PERSONAL BEST</span>':'')+
      (r.wrong===0?'<span class="pill">NO MISS</span>':'');
    $('resultMetrics').innerHTML=[
      metric('RAW KPM',round(r.raw),'ミスも含めた打鍵速度'),
      metric('NET KPM',round(r.net),'正解打鍵だけの速度'),
      metric('KANA CPM',round(r.kanaCpm),'完了した読み文字数 / 分'),
      metric('ACCURACY',round(r.accuracy*100,2)+'%','正確率'),
      metric('CORRECT / MISS',`${r.correct} / ${r.wrong}`,'正解打鍵 / ミス打鍵'),
      metric('PEAK 5s',r.peakKpm===null?'—':round(r.peakKpm,0),'5秒窓の最高正解KPM'),
      metric('STABILITY',r.stability===null?'—':round(r.stability,0)+'/100','5秒速度の変動から算出'),
      metric('ENDURANCE',r.endurance===null?'—':round(r.endurance,0)+'%','終盤 ÷ 序盤（同じ時間幅）'),
      metric('ELAPSED',round(r.elapsed,2)+'s','測定時間'),
      metric('COMPLETE',String(r.phrases),'完了した文章数')
    ].join('');
    diagnosis(r);renderKeyboard(r);renderPairs(r);comparison(r);
  }
  function drawChart(canvas, data, options={}) {
    const parent=canvas.parentElement;
    if(!parent || parent.getBoundingClientRect().width<2)return;
    const w=Math.max(250,canvas.getBoundingClientRect().width),h=Math.max(150,canvas.getBoundingClientRect().height);
    const dpr=Math.min(window.devicePixelRatio||1,2);
    canvas.width=Math.round(w*dpr);canvas.height=Math.round(h*dpr);
    const c=canvas.getContext('2d');c.setTransform(dpr,0,0,dpr,0,0);
    const L=44,R=14,T=14,B=32,W=w-L-R,H=h-T-B;
    c.clearRect(0,0,w,h);
    if(!data.length){c.fillStyle='#99abc4';c.font='13px sans-serif';c.fillText('まだ記録がありません。',20,h/2);return;}
    const values=data.map(x=>x.y);
    const floorY=Math.max(0,Math.floor(Math.min(...values)/50)*50-50);
    const ceilY=Math.max(floorY+50,Math.ceil(Math.max(...values)/50)*50+50);
    const maxX=Math.max(1,data.at(-1).x),minX=Math.min(0,data[0].x);
    const xx=x=>L+(x-minX)/Math.max(1,maxX-minX)*W;
    const yy=y=>T+H-(y-floorY)/(ceilY-floorY)*H;
    c.lineWidth=1;c.font='11px ui-monospace,monospace';c.textBaseline='middle';
    for(let i=0;i<=4;i++){
      const y=floorY+(ceilY-floorY)*i/4,py=yy(y);
      c.strokeStyle='#30405a';c.beginPath();c.moveTo(L,py);c.lineTo(L+W,py);c.stroke();
      c.textAlign='right';c.fillStyle='#95aac3';c.fillText(Math.round(y).toString(),L-7,py);
    }
    c.beginPath();data.forEach((p,i)=>i?c.lineTo(xx(p.x),yy(p.y)):c.moveTo(xx(p.x),yy(p.y)));
    c.strokeStyle='#64e4cf';c.lineWidth=2.5;c.lineJoin='round';c.stroke();
    c.fillStyle='#a4eae0';
    data.forEach(p=>{c.beginPath();c.arc(xx(p.x),yy(p.y),data.length>25?2:3,0,Math.PI*2);c.fill();});
    c.fillStyle='#95aac3';c.textAlign='center';c.textBaseline='alphabetic';
    for(let i=0;i<=4;i++) {
      const x=minX+(maxX-minX)*i/4;
      c.fillText(options.xLabel==='回' ? String(Math.round(x)) : round(x,0)+'s',xx(x),h-8);
    }
  }
  function drawSpeed(r){drawChart($('speedChart'),r.bins||[]);}
  function renderHistory(){
    const records=recordsFor(mode),list=$('historyList');
    $('historyModeLabel').textContent=`/ ${mode==='long'?'長文':mode+'秒'}`;
    const recent=records.slice(-15).reverse();
    list.innerHTML=recent.length?recent.map(r=>`<div class="record"><span>${safeText(new Date(r.date).toLocaleString('ja-JP'))}</span><strong>${safeText(grade(r.score).label)} / ${round(r.score)}</strong></div>`).join(''):'<p class="small">このモードの記録はありません。</p>';
    if($('historyDetails').open) drawHistory();
  }
  function drawHistory(){
    const data=recordsFor(mode).slice(-35).map((r,i)=>({x:i+1,y:r.score}));
    drawChart($('historyChart'),data,{xLabel:'回'});
  }

  // ----- 設定 / ファイル ------------------------------------------------
  function updatePrefs() {
    prefs.display=$('displayMode').value;
    prefs.size=$('romanSize').value;
    putJson(PREFS,prefs);
    if(session)renderPrompt();
  }
  function validateCustom(text,reading) {
    if(!text.trim()||!reading.trim())throw new Error('文章と読みを両方入力してください。');
    if(text.length>1000 || reading.length>1000)throw new Error('文章・読みはそれぞれ1000文字以内にしてください。');
    if(tokensOf(reading).reduce((n,t)=>n+t.kana.length,0)<40 && $('useCustom').checked)throw new Error('長文モードのカスタム文章は、読みを40文字以上にしてください。');
  }
  function applyCustom(){
    const text=$('customText').value.trim(),reading=$('customReading').value.trim();
    try {
      if(text||reading||$('useCustom').checked)validateCustom(text,reading);
      prefs.customText=text;prefs.customReading=reading;prefs.useCustom=$('useCustom').checked;
      updatePrefs();putJson(PREFS,prefs);
      if(mode==='long'&&session?.phase!=='running')newSession();
      alert('設定を保存しました。');
    }catch(e){alert(e.message);}
  }
  function downloadRecords(){
    const payload={app:'TYPE-LAB',schema:1,exportedAt:new Date().toISOString(),records:history};
    const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json;charset=utf-8'});
    const url=URL.createObjectURL(blob),a=document.createElement('a');
    a.href=url;a.download='typing-lab-records-'+new Date().toISOString().slice(0,10)+'.json';
    document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);
  }
  async function importRecords(file){
    try {
      if(file.size>10*1024*1024)throw new Error('10MB以下のJSONを選んでください。');
      const data=JSON.parse(await file.text());
      if(data.app!=='TYPE-LAB'||data.schema!==1||!Array.isArray(data.records))throw new Error('対応するTYPE//LABのバックアップではありません。');
      const valid=data.records.filter(x=>x&&['30','60','long'].includes(x.mode)&&Number.isFinite(x.score)&&x.score>=0&&typeof x.date==='string');
      if(valid.length!==data.records.length)throw new Error('バックアップに不正な記録があります。');
      if(!confirm(`${valid.length}件の記録を現在の履歴に追加します。よろしいですか？`))return;
      const all=[...history,...valid];
      const map=new Map();
      for(const r of all) map.set([r.date,r.mode,Number(r.score).toFixed(6)].join('|'),r);
      history=[...map.values()].sort((a,b)=>a.date.localeCompare(b.date)).slice(-MAX_RECORDS);
      if(!putJson(STORE,history))throw new Error('保存領域に書き込めませんでした。');
      renderSide();renderHistory();alert('履歴を読み込みました。');
    }catch(e){alert('復元できません：'+e.message);}
    $('importFile').value='';
  }
  // ----- UI イベント ----------------------------------------------------
  document.querySelectorAll('.mode').forEach(b=>b.addEventListener('click',()=>{setMode(b.dataset.mode);b.blur();}));
  $('newBtn').addEventListener('click',()=>{if(session?.phase!=='running')newSession();$('newBtn').blur();});
  $('abortBtn').addEventListener('click',()=>{if(session?.phase==='running')abort('測定を中止しました。記録は保存していません。');$('abortBtn').blur();});
  $('retryBtn').addEventListener('click',()=>{newSession();$('retryBtn').blur();$('playArea').scrollIntoView({behavior:'smooth'});});
  $('homeBtn').addEventListener('click',()=>{$('playArea').scrollIntoView({behavior:'smooth'});});
  $('displayMode').addEventListener('change',updatePrefs);
  $('romanSize').addEventListener('change',updatePrefs);
  $('applyCustomBtn').addEventListener('click',()=>{applyCustom();$('applyCustomBtn').blur();});
  $('historyDetails').addEventListener('toggle',()=>{if($('historyDetails').open)requestAnimationFrame(drawHistory);});
  $('exportBtn').addEventListener('click',downloadRecords);
  $('importBtn').addEventListener('click',()=>$('importFile').click());
  $('importFile').addEventListener('change',e=>{if(e.target.files[0])importRecords(e.target.files[0]);});
  $('clearBtn').addEventListener('click',()=>{
    if(!history.length)return;
    if(confirm('保存済みの全モードの記録を削除します。元には戻せません。よろしいですか？')){
      history=[];putJson(STORE,history);renderSide();renderHistory();
    }
  });
  window.addEventListener('keydown',onKey,{capture:true});
  document.addEventListener('visibilitychange',()=>{
    if(document.hidden && session?.phase==='running')abort('別のタブに移動したため測定を無効にしました。');
  });
  window.addEventListener('resize',()=>{
    if(latestResult&&$('results').classList.contains('active'))drawSpeed(latestResult);
    if($('historyDetails').open)drawHistory();
  });
  $('displayMode').value=prefs.display;$('romanSize').value=prefs.size;
  $('customText').value=prefs.customText;$('customReading').value=prefs.customReading;
  $('useCustom').checked=!!prefs.useCustom;
  newSession();renderHistory();
  // 自己検証用：通常の画面操作には影響しない読み取り専用API。
  window.TYPE_LAB_DEBUG=Object.freeze({tokensOf,grade,advance,startStates,preferred,expectedSuffix,SHORT,longTexts});
})();
</script>
